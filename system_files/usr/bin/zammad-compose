#!/bin/bash
# Runs docker compose for the Zammad test environment with the files baked into the image,
# see docs/inbetriebnahme.md step 7. All arguments go to docker compose, for example
#   zammad-compose up -d
#   zammad-compose ps
#   zammad-compose down -v
set -euo pipefail
base=/usr/share/manuel
# The ports listen only on the Tailscale address, see docs/adr/0047-dienste-zum-testen-im-tailnet-oeffnen.adoc
bind_ip=$(tailscale ip -4 2>/dev/null | head -n 1 || true)
if [[ -z "$bind_ip" ]]; then
    echo "Tailscale hat keine Adresse, die Ports der Testumgebung hören deshalb nur auf 127.0.0.1." >&2
    bind_ip=127.0.0.1
fi
exec sudo DOCKER_HOST=unix:///run/podman/podman.sock MANUEL_BIND_IP="$bind_ip" docker-compose -p zammad \
    --project-directory "$base/zammad-docker-compose" \
    --env-file "$base/testumgebung/zammad.env" \
    -f "$base/zammad-docker-compose/docker-compose.yml" \
    -f "$base/testumgebung/compose.override.yml" "$@"
