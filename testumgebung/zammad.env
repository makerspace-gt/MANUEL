# Settings for zammad-docker-compose in the test environment, see compose.override.yml.
# Elasticsearch runs with the defaults of zammad-docker-compose, because the knowledge base keeps its
# vectors there, see docs/adr/0043-eine-testumgebung-auf-manuel-betreiben.adoc.
# Local transcription of voicemails, see zammad/voicemail.rb
MANUEL_WHISPER_URL=http://whisper:8080/inference
# Check of the device type with d3:9b, see zammad/category_check.rb
MANUEL_CATEGORY_CHECK_URL=http://category-check:8090/check
# Base settings instead of the wizard, see zammad/system.rb. Address and password of the admin are
# private and come from /etc/manuel/zammad.env on MANUEL.
MANUEL_URL=http://manuel:8080
MANUEL_ORGANIZATION=Repair Café Test
